    <!-- INTEGRATED ADBLOCK ENGINE -->
    <script>
      function placeholderProbe() {
        return new Promise((resolve) => {
          const testElement = document.createElement('div');
          testElement.className = 'adsbygoogle adsbox pub_300x250 pub_300x250m pub_728x90 text-ad textAd';
          testElement.style.position = 'absolute';
          testElement.style.top = '-9999px';
          testElement.style.left = '-9999px';
          testElement.style.width = '1px';
          testElement.style.height = '1px';
          testElement.style.opacity = '0';
          testElement.style.pointerEvents = 'none';
          document.body.appendChild(testElement);

          const rect = testElement.getBoundingClientRect();
          const style = window.getComputedStyle(testElement);
          const blocked =
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            rect.width === 0 ||
            rect.height === 0;

          testElement.remove();
          resolve(blocked);
        });
      }

      function networkProbe() {
        return new Promise((resolve) => {
          const script = document.createElement('script');
          const cleanup = () => {
            if (script.parentNode) {
              script.parentNode.removeChild(script);
            }
          };

          const timer = window.setTimeout(() => {
            cleanup();
            resolve(false);
          }, 600);

          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
          script.onload = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(false);
          };
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(true);
          };

          document.head.appendChild(script);
        });
      }

      function handleAdBlocker() {
        document.getElementById("adblock-overlay").style.display = "block";
        const dashboardContent = document.getElementById("layout-wrapper");
        if (dashboardContent) {
          dashboardContent.style.display = "none";
        }
      }

      window.addEventListener('DOMContentLoaded', async function() {
        const placeholderBlocked = await placeholderProbe();
        const adRequestBlocked = await networkProbe();
        
        if (placeholderBlocked || adRequestBlocked) {
          handleAdBlocker();
        }
      });
    </script>
    <script>
  window.addEventListener('DOMContentLoaded', function() {
    const submitBtn = document.getElementById('submit-mth');
    const form = submitBtn ? submitBtn.closest('form') : null;
    const cooldownTime = 1 * 60 * 1000; // 3 minutes in milliseconds

    if (!submitBtn || !form) return;

    function checkCooldown() {
      const lastSubmit = localStorage.getItem('captcha_last_submit');
      
      if (lastSubmit) {
        const elapsed = Date.now() - parseInt(lastSubmit, 10);
        
        if (elapsed < cooldownTime) {
          const remaining = cooldownTime - elapsed;
          submitBtn.disabled = true;

          // Calculate remaining minutes and seconds
          const secondsLeft = Math.ceil(remaining / 1000);
          const minutes = Math.floor(secondsLeft / 60);
          const seconds = secondsLeft % 60;
          
          // Format seconds with leading zero if needed
          const formattedSeconds = seconds < 10 ? '0' + seconds : seconds;
          
          // Update button text with the countdown
          submitBtn.textContent = `Wait ${minutes}:${formattedSeconds}`;

          // Check again in 1 second
          setTimeout(checkCooldown, 1000);
          return;
        }
      }
      
      // Re-enable button once cooldown has passed
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Answer";
    }

    // Capture the click/submit action to initiate the cooldown
    form.addEventListener('submit', function() {
      localStorage.setItem('captcha_last_submit', Date.now().toString());
    });

    // Run the check on page load
    checkCooldown();
  });
</script>
