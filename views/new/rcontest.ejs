<!DOCTYPE html>
<html
  lang="en"
  class="light-style layout-menu-fixed"
  dir="ltr"
  data-theme="theme-default"
  data-assets-path="../assets/"
  data-template="vertical-menu-template-free"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"
    />
    <title><%= title ? title : appName %></title>
    <meta name="description" content="" />
    <link rel="icon" type="image/x-icon" href="/images/kkk.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght=0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/apex-charts/apex-charts.css" />
    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>

    <!-- Referral Contest Custom Styles -->
    <style>
      .contest-header {
        text-align: center;
        margin-bottom: 25px;
      }
      .contest-header h1 {
        margin: 0 0 10px 0;
        color: #2c3e50;
      }
      .contest-header p {
        color: #7f8c8d;
        margin: 5px 0;
      }
      .countdown {
        font-weight: bold;
        color: #e74c3c;
      }
      .leaderboard-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
      }
      .leaderboard-table th, .leaderboard-table td {
        padding: 14px 16px;
        text-align: left;
      }
      .leaderboard-table th {
        background-color: #34495e;
        color: #ffffff;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .leaderboard-table tr {
        border-bottom: 1px solid #ecf0f1;
      }
      .leaderboard-table tr:hover {
        background-color: #f8f9fa;
      }
      .rank-1 { background-color: #fff9e6; font-weight: bold; }
      .rank-2 { background-color: #f2f2f2; font-weight: bold; }
      .rank-3 { background-color: #faf0e6; font-weight: bold; }
      .badge-rank {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        color: #fff;
      }
      .gold { background-color: #f1c40f; }
      .silver { background-color: #95a5a6; }
      .bronze { background-color: #e67e22; }
      .reward { color: #27ae60; font-weight: bold; }
      .empty-state { text-align: center; padding: 20px; color: #7f8c8d; }
    </style>
  </head>
  <body>
    <!-- ADBLOCKER OVERLAY -->
    <div id="adblock-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 99999; color: white; text-align: center; padding-top: 20vh; font-family: sans-serif;">
      <div style="max-width: 500px; margin: 0 auto; background: #222; padding: 40px; border-radius: 8px; border: 1px solid #ff4444;">
        <h2 style="color: #ff4444; margin-bottom: 20px;">Ad Blocker Detected!</h2>
        <p style="font-size: 16px; line-height: 1.6;">Our network is supported by advertisements. To access your dashboard and claim rewards, you must completely disable your Ad Blocker or whitelist our domain.</p>
        <button onclick="window.location.reload()" style="margin-top: 25px; padding: 12px 30px; background: #ff4444; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">I have disabled it, Refresh</button>
      </div>
    </div>
    <!-- /ADBLOCKER OVERLAY -->
    
    <div id="layout-wrapper" class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
          <div class="app-brand demo">
            <a href="/" class="app-brand-link">
              <img src="/images/kkk.jpg" width="25" height="20" alt="Fluwent Logo">
              <span class="app-brand-text demo menu-text fw-bolder ms-2"><%= appName %></span>
            </a>
            <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
              <i class="bx bx-chevron-left bx-sm align-middle"></i>
            </a>
          </div>
          <div class="menu-inner-shadow"></div>
          <ul class="menu-inner py-1">
            <!-- Dashboard -->
            <li class="menu-item active">
              <a href="/dashboard" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div data-i18n="Analytics">Dashboard</div>
              </a>
            </li>
            <!-- Menu -->
            <li class="menu-item">
              <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="bx bx-list-ul"></i>
                <div data-i18n="Layouts">Faucet List</div>
              </a>
              <ul class="menu-sub">
                <li class="menu-item">
                  <a href="/math" class="menu-link">
                    <i class="bx bx-calculator"></i>
                    <div data-i18n="Without menu">Solve</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/typing-captcha" class="menu-link">
                    <i class="bx bx-font-family"></i>
                    <div data-i18n="Without navbar">Type</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/ptc3" class="menu-link">
                    <i class="bx bx-link"></i>
                    <div data-i18n="Container">Shortlink</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/page1" class="menu-link">
                    <i class="bx bx-layout"></i>
                    <div data-i18n="Fluid">Page</div>
                  </a>
                </li>
              </ul>
            </li>
            <li class="menu-item">
              <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="bx bx-book-open"></i>
                <div data-i18n="Layouts">Offerwall</div>
              </a>
              <ul class="menu-sub">
                <li class="menu-item">
                  <a href="/timewall" class="menu-link">
                    <i class="bx bx-timer"></i>
                    <div data-i18n="Without menu">Timewall</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/complete-task" class="menu-link">
                    <i class="bx bx-calendar"></i>
                    <div data-i18n="Fluid">Daily-task</div>
                  </a>
                </li>
              </ul>
            </li>
            <li class="menu-item">
              <a href="/available-cards" class="menu-link">
                <i class="bx bx-gift"></i>
                <div data-i18n="Blank">Reward cards</div>
              </a>
            </li>
            <li class="menu-item">
              <a href="/convert" class="menu-link">
                <i class="bx bx-refresh"></i>
                <div data-i18n="Blank">Convert Points</div>
              </a>
            </li>
            <li class="menu-item active">
              <a href="/rcontest" class="menu-link">
                <i class="menu-icon tf-icons bx bx-trophy"></i>
                <div data-i18n="Blank">Weekly Event</div>
              </a>
            </li>
            <li class="menu-item">
              <a href="/referral" class="menu-link">
                <i class="bx bx-group"></i>
                <div data-i18n="Blank">Referrals</div>
              </a>
            </li>
            <li class="menu-item">
              <a href="/withdrawal" class="menu-link">
                <i class="bx bx-wallet-alt"></i>
                <div data-i18n="Blank">Withdrawal</div>
              </a>
            </li>
            <li class="menu-item">
              <a href="/contact" class="menu-link">
                <i class="menu-icon tf-icons bx bx-support"></i>
                <div data-i18n="Support">Support</div>
              </a>
            </li>
          </ul>
        </aside>

        <div class="layout-page">
          <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
            <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
              <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                <i class="bx bx-menu bx-sm"></i>
              </a>
            </div>
            <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse"></div>
            <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
              <ul class="navbar-nav flex-row align-items-center ms-auto">
                <!-- User -->
                <li class="nav-item navbar-dropdown dropdown-user dropdown">
                  <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                    <div class="avatar avatar-online">
                      <img src="/images/sett.jpg" alt class="w-px-40 h-auto rounded-circle" />
                    </div>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <a class="dropdown-item" href="#">
                        <div class="d-flex">
                          <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-online">
                              <img src="/images/pro.jpg" alt class="w-px-40 h-auto rounded-circle" />
                            </div>
                          </div>
                          <div class="flex-grow-1">
                            <span class="fw-semibold d-block"><%= user.username %>!</span>
                            <small class="text-muted">Username</small>
                          </div>
                        </div>
                      </a>
                    </li>
                    <li>
                      <div class="dropdown-divider"></div>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/profile">
                        <i class="bx bx-user me-2"></i>
                        <span class="align-middle">My profile</span>
                      </a>
                    </li>
                    <li>
                      <div class="dropdown-divider"></div>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/logout">
                        <i class="bx bx-power-off me-2"></i>
                        <span class="align-middle">Log Out</span>
                      </a>
                    </li>
                  </ul>
                </li>
                <!--/ User -->
              </ul>
            </div>
          </nav>
          
          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="container py-4">
                <div class="row justify-content-center">
                  <div class="col-lg-10">
                    <div class="card shadow-sm p-4">
                      
                      <!-- Referral Contest Leaderboard Integrated Section -->
                      <div class="contest-header">
                        <h1>Weekly $100 Referral Contest</h1>
                        <p>Event runs from <strong>Monday 00:00 UTC</strong> to <strong>Sunday 23:59 UTC</strong></p>
                        <p>Top 10 users with the most referrals split the <strong>$100 prize pool</strong>!</p>
                      </div>

                      <% if (typeof topUsers === 'undefined' || topUsers.length === 0) { %>
                        <div class="empty-state">
                          <p>No referrals registered yet this week. Be the first to invite friends!</p>
                        </div>
                      <% } else { %>
                        <div class="table-responsive text-nowrap">
                          <table class="table leaderboard-table">
                            <thead>
                              <tr>
                                <th>Rank</th>
                                <th>User</th>
                                <th>Referral Code</th>
                                <th>Weekly Referrals</th>
                                <th>Est. Reward</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% topUsers.forEach((user, index) => { %>
                                <% const rank = index + 1; %>
                                <tr class="<%= rank === 1 ? 'rank-1' : rank === 2 ? 'rank-2' : rank === 3 ? 'rank-3' : '' %>">
                                  <td>
                                    <% if (rank === 1) { %>
                                      <span class="badge-rank gold">#1</span>
                                    <% } else if (rank === 2) { %>
                                      <span class="badge-rank silver">#2</span>
                                    <% } else if (rank === 3) { %>
                                      <span class="badge-rank bronze">#3</span>
                                    <% } else { %>
                                      #<%= rank %>
                                    <% } %>
                                  </td>
                                  <td><%= user.name %></td>
                                  <td><code><%= user.username %></code></td>
                                  <td><strong><%= user.weeklyReferrals %></strong></td>
                                  <td class="reward"><%= getEstimatedReward(rank) %></td>
                                </tr>
                              <% }); %>
                            </tbody>
                          </table>
                        </div>
                      <% } %>

                    </div>
                  </div>
                </div>
              </div>
            </div>
            <%- include('../partials/newfoot') %>
          </div>
        </div>
      </div>
      <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    
    <!-- Core JS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <script src="/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/dashboards-analytics.js"></script>
    <script async defer src="https://buttons.github.io/buttons.js"></script>

    <!-- INTEGRATED ADBLOCK ENGINE -->
    <script>
      function placeholderProbe() {
        return new Promise((resolve) => {
          const testElement = document.createElement('div');
          testElement.className = 'adsbygoogle adsbox pub_300x250 pub_300x250m pub_728x90 text-ad textAd';
          testElement.style.position = 'absolute';
          testElement.style.top = '-9999px';
          testElement.style.left = '-9999px';
          testElement.style.width = '1px';
          testElement.style.height = '1px';
          testElement.style.opacity = '0';
          testElement.style.pointerEvents = 'none';
          document.body.appendChild(testElement);
          const rect = testElement.getBoundingClientRect();
          const style = window.getComputedStyle(testElement);
          const blocked =
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            rect.width === 0 ||
            rect.height === 0;
          testElement.remove();
          resolve(blocked);
        });
      }
      function networkProbe() {
        return new Promise((resolve) => {
          const script = document.createElement('script');
          const cleanup = () => {
            if (script.parentNode) {
              script.parentNode.removeChild(script);
            }
          };
          const timer = window.setTimeout(() => {
            cleanup();
            resolve(false);
          }, 600);
          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
          script.onload = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(false);
          };
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(true);
          };
          document.head.appendChild(script);
        });
      }
      function handleAdBlocker() {
        document.getElementById("adblock-overlay").style.display = "block";
        const dashboardContent = document.getElementById("layout-wrapper");
        if (dashboardContent) {
          dashboardContent.style.display = "none";
        }
      }
      window.addEventListener('DOMContentLoaded', async function() {
        const placeholderBlocked = await placeholderProbe();
        const adRequestBlocked = await networkProbe();
        
        if (placeholderBlocked || adRequestBlocked) {
          handleAdBlocker();
        }
      });
    </script>
  </body>
</html>