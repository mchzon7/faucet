<!DOCTYPE html>
<html lang="en"
  lang="en"
  class="light-style layout-menu-fixed"
  dir="ltr"
  data-theme="theme-default"
  data-assets-path="../assets/"
  data-template="vertical-menu-template-free">
<head>
   <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Icons. Uncomment required icon fonts -->
    <link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="/assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />

    <link rel="stylesheet" href="/assets/vendor/libs/apex-charts/apex-charts.css" />
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 font-sans text-slate-900">
  <%- include('partials/header') %>

  <main>
    <section class="#f0faff">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-20">
        <div>
          <span class="inline-flex rounded-full bg-[#595cd9]/15 px-4 py-2 text-sm font-bold text-brand-[#595cd9]/80">Daily crypto and cash rewards</span>
          <h1 class="mt-6 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-brand-ink sm:text-5xl lg:text-6xl">Turn spare minutes into verified faucet earnings.</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Claim timed rewards, complete high-value offerwalls, unlock shortlink bonuses, and get paid through trusted withdrawal methods.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/register" class="rounded-lg bg-[#595cd9] px-6 py-3 text-center text-base font-extrabold text-white shadow-sm hover:bg-[#595cd9]">Start Earning Now</a>
            <a href="/login" class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-extrabold text-slate-800 hover:bg-slate-100">Login</a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-brand-ink  p-5 text-white shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div>
              <p class="text-sm font-semibold text-[#595cd9]">Live platform stats</p>
              <h2 class="text-2xl  font-extrabold">Earning activity</h2>
            </div>
            <span class="rounded-full bg-[#595cd9]/15 px-3 py-1 text-xs font-bold text-[#595cd9]">LIVE</span>
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-white/10 p-4">
              <p class="text-sm text-slate-300">Total Users</p>
              <p class="mt-2 text-3xl font-extrabold"><%= stats.totalUsers.toLocaleString() %></p>
            </div>
            <div class="rounded-xl bg-white/10 p-4">
              <p class="text-sm text-slate-300">Total Earned</p>
              <p class="mt-2 text-3xl font-extrabold">$<%= Math.round(stats.totalEarned).toLocaleString() %></p>
            </div>
            <div class="rounded-xl bg-white/10 p-4">
              <p class="text-sm text-slate-300">Faucet Claims Today</p>
              <p class="mt-2 text-3xl font-extrabold"><%= stats.faucetClaimsToday.toLocaleString() %></p>
            </div>
            <div class="rounded-xl bg-white/10 p-4">
              <p class="text-sm text-slate-300">All-Time Claims</p>
              <p class="mt-2 text-3xl font-extrabold"><%= stats.totalClaims.toLocaleString() %></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="earn" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-extrabold uppercase tracking-wider text-[#595cd9]/75">Ways to earn</p>
        <h2 class="mt-2 text-3xl font-extrabold text-brand-ink">Multiple reward paths in one dashboard</h2>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        <% [
          ['Faucet Claim', 'Timer-based claim rounds that reward consistent daily activity.', '⏱'],
          ['Shortlinks', 'High-paying third-party short URL walls with instant credit checks.', '🔗'],
          ['Offerwalls', 'Surveys, trials, app installs, and partner tasks for bigger payouts.', '📋'],
          ['Micro Tasks', 'Custom admin-approved jobs for users who want flexible rewards.', '✓']
        ].forEach((feature) => { %>
          <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-5 grid h-11 w-11 place-items-center rounded-lg bg-[#595cd9] text-xl"><%= feature[2] %></div>
            <h3 class="text-lg font-extrabold text-slate-950"><%= feature[0] %></h3>
            <p class="mt-3 text-sm leading-6 text-slate-600"><%= feature[1] %></p>
          </article>
        <% }) %>
      </div>
    </section>

    <section id="payouts" class="bg-slate-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <p class="text-sm font-extrabold uppercase tracking-wider text-[#595cd9]/80">Proofs</p>
            <h2 class="mt-2 text-3xl font-extrabold text-brand-ink">Recent payouts</h2>
          </div>
          <a href="/register" class="text-sm font-extrabold text-[#595cd9]/80 hover:text-[#595cd9]">Join the next payout batch</a>
        </div>
        <div class="overflow-hidden rounded-xl border border-slate-200">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 bg-white text-left text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-5 py-4 font-extrabold">Username</th>
                  <th class="px-5 py-4 font-extrabold">Amount</th>
                  <th class="px-5 py-4 font-extrabold">Method</th>
                  <th class="px-5 py-4 font-extrabold">Date/Time</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% recentPayouts.forEach((payout) => { %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-5 py-4 font-bold text-slate-900"><span class="method-pill"><%= payout.username %></span></td>
                    <td class="px-5 py-4 font-extrabold text-[#595cd9]"><span class="method-pill">$<%= Number(payout.amount).toFixed(2) %> <%= payout.currency %></span></td>
                    <td class="px-5 py-4 text-slate-700"><span class="method-pill"><%= payout.method %></span></td>
                    <td class="px-5 py-4 text-slate-500"><%= new Date(payout.paidAt).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short' }) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-sm font-extrabold uppercase tracking-wider text-[#595cd9]">FAQ</p>
        <h2 class="mt-2 text-3xl font-extrabold text-brand-ink">Common questions</h2>
      </div>
      <div class="mt-8 space-y-3">
        <% [
          ['What is the minimum withdrawal?', 'The default minimum withdrawal is $2.00, though exact thresholds can vary by payment method and campaign reward type.'],
          ['Can I use a VPN?', 'No. VPN, proxy, emulator, and multi-account activity can trigger fraud checks and may lead to withheld rewards.'],
          ['How fast are payouts processed?', 'Most approved withdrawals are processed within 24 hours. Larger withdrawals may require an additional manual review.'],
          ['Do offerwall rewards credit instantly?', 'Many credit instantly, while some partner offers require verification before funds are released to your balance.']
        ].forEach((faq, index) => { %>
          <div class="rounded-xl border border-slate-200 bg-white">
            <button type="button" class="faq-toggle flex w-full items-center justify-between gap-4 px-5 py-4 text-left font-extrabold text-slate-950" aria-expanded="<%= index === 0 ? 'true' : 'false' %>">
              <span><%= faq[0] %></span>
              <span class="text-xl text-[#595cd9]">+</span>
            </button>
            <div class="faq-panel <%= index === 0 ? '' : 'hidden' %> px-5 pb-5 text-sm leading-6 text-slate-600"><%= faq[1] %></div>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script>
    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const panel = button.nextElementSibling;
        const expanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!expanded));
        panel.classList.toggle('hidden');
      });
    });

    
  </script>
</body>
</html>
