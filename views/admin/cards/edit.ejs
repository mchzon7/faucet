<%- include('./layout') %>
<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="fas fa-edit me-2"></i>Edit Credit Card
                </h4>
            </div>
            <div class="card-body">
                <% if (error) { %>
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                    </div>
                <% } %>

                <div class="mb-3">
                    <strong>Card Number:</strong> <%= card.cardNumber %>
                </div>

                <form action="/admin/card/<%= card._id %>" method="POST">
                    <input type="hidden" name="_method" value="PUT">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="amount" class="form-label">
                                <i class="fas fa-dollar-sign me-1"></i>Card Amount
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="amount" name="amount" 
                                       min="1" step="0.01" required 
                                       value="<%= card.amount %>">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="displayAmount" class="form-label">
                                <i class="fas fa-tag me-1"></i>Display Amount
                            </label>
                            <input type="text" class="form-control" id="displayAmount" name="displayAmount" 
                                   value="<%= card.displayAmount %>">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="totalRedemptions" class="form-label">
                                <i class="fas fa-users me-1"></i>Total Redemptions
                            </label>
                            <input type="number" class="form-control" id="totalRedemptions" 
                                   name="totalRedemptions" min="1" required 
                                   value="<%= card.totalRedemptions %>">
                            <div class="form-text">Current remaining: <%= card.remainingRedemptions %></div>
                        </div>
                        <div class="col-md-6">
                            <label for="pointsRequired" class="form-label">
                                <i class="fas fa-star me-1"></i>Points Required
                            </label>
                            <input type="number" class="form-control" id="pointsRequired" 
                                   name="pointsRequired" min="0" required 
                                   value="<%= card.pointsRequired %>">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="expiresAt" class="form-label">
                            <i class="far fa-calendar-alt me-1"></i>Expiry Date
                        </label>
                        <input type="datetime-local" class="form-control" id="expiresAt" name="expiresAt" 
                               value="<%= card.expiresAt ? new Date(card.expiresAt).toISOString().slice(0, 16) : '' %>">
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" name="isActive"
                                <%= card.isActive ? 'checked' : '' %>>
                            <label class="form-check-label" for="isActive">
                                <i class="fas fa-power-off me-1"></i>Card is Active
                            </label>
                        </div>
                    </div>

                    <!-- Statistics -->
                    <div class="card mb-3 bg-light">
                        <div class="card-body">
                            <h6 class="card-title">
                                <i class="fas fa-chart-pie me-2"></i>Card Statistics
                            </h6>
                            <div class="row text-center">
                                <div class="col-4">
                                    <small class="text-muted">Total Redemptions</small>
                                    <h5><%= card.totalRedemptions %></h5>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Used</small>
                                    <h5><%= card.redeemedBy ? card.redeemedBy.length : 0 %></h5>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Remaining</small>
                                    <h5><%= card.remainingRedemptions %></h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="/admin/cards" class="btn btn-secondary me-md-2">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Update Card
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>