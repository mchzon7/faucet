                        <span class="align-middle">Log Out</span>
                      </a>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>
          </nav>

          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible" role="alert">
                  <%= success_msg %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>
              <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible" role="alert">
                  <%= error_msg %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <div class="col-lg-10 mx-auto">
                <div class="card shadow-sm">
                  <div class="card-header">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Credit Card</h4>
                  </div>
                  <div class="card-body">
                    <form action="/admin/cards/create" method="POST" class="needs-validation" novalidate>
                      <div class="row">
                        <div class="col-md-6">
                          <div class="mb-3">
                            <label for="cardNumber" class="form-label">
                              <i class="fas fa-credit-card me-1"></i>Card Number
                            </label>
                            <div class="input-group">
                              <span class="input-group-text"><i class="fas fa-hashtag"></i></span>
                              <input type="number" class="form-control" id="cardNumber" name="cardNumber" required placeholder="Enter unique card number">
                            </div>
                          </div>
                          
                          <div class="mb-3">
                            <label for="amount" class="form-label">
                              <i class="fas fa-dollar-sign me-1"></i>Card Amount value
                            </label>
                            <input type="number" class="form-control" id="amount" name="amount" required placeholder="e.g. 50">
                          </div>

                          <div class="mb-3">
                            <label for="displayAmount" class="form-label">
                              <i class="fas fa-font me-1"></i>Display Text Amount
                            </label>
                            <input type="text" class="form-control" id="displayAmount" name="displayAmount" required placeholder="e.g. $50 Card / 500 V-bucks">
                          </div>
                        </div>

                        <div class="col-md-6">
                          <div class="mb-3">
                            <label for="pointsRequired" class="form-label">
                              <i class="fas fa-coins me-1"></i>Points Required
                            </label>
                            <input type="number" class="form-control" id="pointsRequired" name="pointsRequired" required placeholder="Points users need to spend">
                          </div>

                          <div class="mb-3">
                            <label for="totalRedemptions" class="form-label">
                              <i class="fas fa-users me-1"></i>Max Total Redemptions Allowed
                            </label>
                            <input type="number" class="form-control" id="totalRedemptions" name="totalRedemptions" required placeholder="e.g. 100 max uses">
                          </div>

                          <div class="mb-3">
                            <label for="expiresAt" class="form-label">
                              <i class="fas fa-calendar-times me-1"></i>Expiration Date (Optional)
                            </label>
                            <input type="date" class="form-control" id="expiresAt" name="expiresAt">
                          </div>
                        </div>
                      </div>

                      <div class="mt-4 d-flex justify-content-between">
                        <a href="/admin/cards" class="btn btn-outline-secondary">
                          <i class="fas fa-arrow-left me-2"></i>Back to Card Management List
                        </a>
                        <button type="submit" class="btn btn-primary">
                          <i class="fas fa-save me-2"></i>Create Card Panel
                        </button>
                      </div>
                      
                    </form>
                  </div>
                </div>
              </div>

            </div>
            <div class="content-backdrop fade"></div>
          </div>
          
          <%- include('../partials/footer') %>
