
<%- include('./layout') %>
<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-credit-card me-2"></i>Card Details
                </h4>
                <span class="badge <%= card.isActive && card.remainingRedemptions > 0 ? 'bg-success' : 'bg-secondary' %>">
                    <%= card.isActive && card.remainingRedemptions > 0 ? 'Active' : 'Inactive' %>
                </span>
            </div>
            <div class="card-body">
                <!-- Card Preview -->
                <div class="text-center mb-4">
                    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
                        padding: 40px; border-radius: 15px; color: white; max-width: 350px; margin: 0 auto;">
                        <div class="text-end mb-3">
                            <i class="fas fa-credit-card fa-2x"></i>
                        </div>
                        <div class="text-center">
                            <h1><%= card.displayAmount || $${card.amount} %></h1>
                            <small>★ Reward Card</small>
                        </div>
                        <div class="mt-3 text-center">
                            <small><%= card.cardNumber %></small>
                        </div>
                    </div>
                </div>

                <!-- Card Details -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Card Number:</strong>
                        <p><%= card.cardNumber %></p>
                    </div>
                    <div class="col-md-6">
                        <strong>Amount:</strong>
                        <p>$<%= card.amount %></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Total Redemptions:</strong>
                        <p><%= card.totalRedemptions %></p>
                    </div>
                    <div class="col-md-6">
                        <strong>Remaining Redemptions:</strong>
                        <p><%= card.remainingRedemptions %></p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Points Required:</strong>
                        <p><%= card.pointsRequired %></p>
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        <p>
                            <span class="badge <%= card.isActive ? 'bg-success' : 'bg-secondary' %>">
                                <%= card.isActive ? 'Active' : 'Inactive' %>
                            </span>
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Created At:</strong>
                        <p><%= new Date(card.createdAt).toLocaleString() %></p>
                    </div>
                    <div class="col-md-6">
                        <strong>Expires At:</strong>
                        <p><%= card.expiresAt ? new Date(card.expiresAt).toLocaleString() : 'No expiry date' %></p>
                    </div>
                </div>

                <!-- Redemption History -->
                <div class="mt-4">
                    <h5><i class="fas fa-history me-2"></i>Redemption History</h5>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Redeemed At</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (card.redeemedBy && card.redeemedBy.length > 0) { %>
                                    <% card.redeemedBy.forEach(redemption => { %>
                                        <tr>
                                            <td>
                                                <%= redemption.userId ? 
                                                    (redemption.userId.username  redemption.userId.email  'User') : 
                                                    'Unknown User' %>
                                            </td>
                                            <td><%= new Date(redemption.redeemedAt).toLocaleString() %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="2" class="text-center text-muted">
                                            No redemptions yet
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a href="/admin/cards" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <a href="/admin/card/<%= card._id %>/edit" class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Edit Card
                    </a>
                    <button class="btn btn-danger delete-card" data-id="<%= card._id %>">
                        <i class="fas fa-trash me-2"></i>Delete Card
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>