    <script src="/assets/js/dashboards-analytics.js"></script>
    <script async defer src="https://buttons.github.io/buttons.js"></script>
    <!-- Modal Controllers script -->
    <script>
      function openRedeemModal(cardId, amount) {
        document.getElementById('modalCardId').value = cardId;
        document.getElementById('modalCardAmount').innerText = '$' + amount;
        
        const modal = document.getElementById('redeemModal');
        modal.style.display = 'flex';
        setTimeout(() => {
          modal.classList.add('show');
        }, 10);
      }
      function closeRedeemModal() {
        const modal = document.getElementById('redeemModal');
        modal.classList.remove('show');
        setTimeout(() => {
          modal.style.display = 'none';
        }, 200);
      }
    </script>
    <!-- Adblock scripts logic -->
    <script>
      function networkProbe() {
        return new Promise((resolve) => {
          const script = document.createElement('script');
          const cleanup = () => {
            if (script.parentNode) {
              script.parentNode.removeChild(script);
            }
          };
          const timer = window.setTimeout(() => {
            cleanup();
            resolve(false);
          }, 600);
          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
          script.onload = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(true);
          };
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(false);
          };
          document.head.appendChild(script);
        });
      }
      window.addEventListener('DOMContentLoaded', async () => {
        const adsOnline = await networkProbe();
        if (!adsOnline) {
          document.getElementById('adblock-overlay').style.display = 'block';
        }
      });
    </script>
