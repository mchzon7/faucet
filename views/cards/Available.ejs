    <style>
      /* Integrated Redeem Modal Styles */
      #redeemModal {
        display: none;
      }
      .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(67, 89, 113, 0.5);
        backdrop-filter: blur(4px);
        z-index: 1080;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }
      .modal-content-custom {
        background: #ffffff;
        border-radius: 0.5rem;
        box-shadow: 0 0.25rem 1rem rgba(161, 172, 184, 0.45);
        border: 1px solid #d9dee3;
        width: 100%;
        max-width: 450px;
        transform: scale(0.95);
        transition: transform 0.2s ease-in-out;
      }
      .modal-backdrop-custom.show .modal-content-custom {
        transform: scale(1);
      }
      /* Premium Credit Card Styling */
      .premium-credit-card {
        background: linear-gradient(135deg, #2b2c43 0%, #18192a 100%);
        color: #ffffff;
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        min-height: 220px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .premium-credit-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(105, 108, 255, 0.25);
      }
      /* Card Glassmorphism Accents */
      .premium-credit-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, rgba(105, 108, 255, 0.15) 0%, transparent 70%);
        pointer-events: none;
      }
      /* Gold Card Chip Simulation */
      .card-chip {
        width: 42px;
        height: 32px;
        background: linear-gradient(135deg, #e5a93b 0%, #fff1b0 50%, #c98e1d 100%);
        border-radius: 6px;
        position: relative;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.5);
      }
      .card-chip::after {
        content: '';
        position: absolute;
        top: 15%;
        left: 15%;
        right: 15%;
        bottom: 15%;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 4px;
      }
    </style>
  </head>
