          <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="card">
                <div class="card-body">
                  <h3 class="text-center text-primary mb-5">REWARD CARDS</h3>
                  
                  <!-- Loop Professional Credit Cards Container -->
                  <div class="row g-4">
                    <% if (locals.cards && cards.length > 0) { %>
                      <% cards.forEach(card => { %>
                        <div class="col-xl-4 col-md-6 col-12">
                          
                          <!-- Credit Card Element -->
                          <div class="premium-credit-card p-4 d-flex flex-column justify-content-between mb-3">
                            
                            <!-- Card Top Row: Brand & Status -->
                            <div class="d-flex justify-content-between align-items-center">
                              <div>
                                <span class="text-uppercase tracking-wider fs-tiny text-white-50">REWARD PASS</span>
                                <div class="card-chip mt-2"></div>
                              </div>
                              <div class="text-end">
                                <!-- Status logic check -->
                                <% if (card.isActive) { %>
                                  <span class="badge bg-success shadow-sm">ACTIVE</span>
                                <% } else { %>
                                  <span class="badge bg-danger shadow-sm">NOT AVAILABLE</span>
                                <% } %>
                              </div>
                            </div>
                            <!-- Card Middle Row: Card Amount (as card numbers) -->
                            <div class="my-3">
                              <h2 class="text-white fw-bold mb-0 text-shadow-sm">
                                <%= card.displayAmount || ('$' + card.amount) %>
                              </h2>
                              <p class="fs-tiny text-white-50 mb-0">DIGITAL ASSET VALUE</p>
                            </div>
                            <!-- Card Bottom Row: Details & Limits -->
                            <div class="d-flex justify-content-between align-items-end">
                              <div>
                                <span class="fs-tiny text-white-50 d-block">REQUIRED POINTS</span>
                                <span class="fw-bold text-white"><%= card.pointsRequired %> pts</span>
                              </div>
                              
                              <div class="text-end text-white-50">
                                <span class="fs-tiny d-block">REDEMPTION LIMITS</span>
                                <span class="text-white fw-bold fs-7">
                                  <%= card.remainingRedemptions %> / <%= card.totalRedemptions %> left
                                </span>
                              </div>
                            </div>
                          </div>
                          <!-- Action Button (Directly under credit card) -->
                          <div class="px-1 mb-4">
                            <% if (!card.isActive) { %>
                              <button class="btn btn-secondary w-100" disabled>
                                <i class="bx bx-block me-1"></i> Card Unavailable
                              </button>
                            <% } else if (card.isRedeemed) { %>
                              <button class="btn btn-success w-100 text-white" disabled>
                                <i class="bx bx-check-double me-1"></i> Already Redeemed
                              </button>
                            <% } else { %>
                              <button 
                                onclick="openRedeemModal('<%= card._id %>', '<%= card.amount %>')" 
                                class="btn btn-primary w-100"
                                <%= (locals.userPoints < card.pointsRequired || card.remainingRedemptions <= 0) ? 'disabled' : '' %>
                              >
                                <i class="bx bx-gift me-1"></i> 
                                <!-- FIXED TYPO BELOW: card.remainingRedemption changed to card.remainingRedemptions -->
                                <%= (card.remainingRedemptions <= 0) ? 'Limit Reached' : 'Claim Now' %>
                              </button>
                              
                              <% if (locals.userPoints < card.pointsRequired && card.remainingRedemptions > 0) { %>
                                <div class="text-center mt-1">
                                  <small class="text-danger">Insufficient balance for this card</small>
                                </div>
                              <% } %>
                            <% } %>
                          </div>
