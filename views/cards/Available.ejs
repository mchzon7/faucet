    <div id="redeemModal" class="modal-backdrop-custom">
      <div class="modal-content-custom p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="modal-title text-primary m-0 fw-bold">Confirm Redemption</h5>
          <button onclick="closeRedeemModal()" class="btn-close" type="button" aria-label="Close"></button>
        </div>
        
        <form id="modalRedeemForm" action="/redeem-card/" method="POST">
          <input type="hidden" id="modalCardId" name="cardId" value="" />
          
          <p class="text-muted text-sm mb-4">
            You are about to claim <strong id="modalCardAmount" class="text-dark">$0.00</strong>. Enter your details below to confirm the redemption transaction.
          </p>
          <div class="mb-4 text-start">
            <label for="wallet" class="form-label">Payment Username / FaucetPay Account</label>
            <input 
              type="text" 
              id="wallet" 
              name="wallet" 
              placeholder="Enter your username" 
              class="form-control" 
              required 
            />
          </div>
          <div class="row g-2">
            <div class="col-6">
              <button type="button" onclick="closeRedeemModal()" class="btn btn-label-secondary w-100">
                Cancel
              </button>
            </div>
            <div class="col-6">
              <button type="submit" class="btn btn-primary w-100">
                Redeem Now
              </button>
            </div>
          </div>
        </form>
      </div>
