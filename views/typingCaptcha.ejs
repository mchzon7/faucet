<!DOCTYPE html>
<html
  lang="en"
  class="light-style layout-menu-fixed"
  dir="ltr"
  data-theme="theme-default"
  data-assets-path="../assets/"
  data-template="vertical-menu-template-free"
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"
    />
    <title>Admin Dashboard - <%= appName %></title>
    <meta name="description" content="" />
    <link rel="icon" type="image/x-icon" href="/images/kkk.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght=0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/vendor/fonts/boxicons.css" />
    <link rel="stylesheet" href="/assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="/assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="/assets/css/demo.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="/assets/vendor/libs/apex-charts/apex-charts.css" />
    <script src="/assets/vendor/js/helpers.js"></script>
    <script src="/assets/js/config.js"></script>
  </head>
  <body>
    <!-- ADBLOCKER OVERLAY -->
    <div id="adblock-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 99999; color: white; text-align: center; padding-top: 20vh; font-family: sans-serif;">
      <div style="max-width: 500px; margin: 0 auto; background: #222; padding: 40px; border-radius: 8px; border: 1px solid #ff4444;">
        <h2 style="color: #ff4444; margin-bottom: 20px;">Ad Blocker Detected!</h2>
        <p style="font-size: 16px; line-height: 1.6;">Our network is supported by advertisements. To access your dashboard and claim rewards, you must completely disable your Ad Blocker or whitelist our domain.</p>
        <button onclick="window.location.reload()" style="margin-top: 25px; padding: 12px 30px; background: #ff4444; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">I have disabled it, Refresh</button>
      </div>
    </div>
    <!-- /ADBLOCKER OVERLAY -->
    
    <div id="layout-wrapper" class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <!-- SIDEBAR MENU -->
        <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
          <div class="app-brand demo">
            <a href="/admin/dashboard" class="app-brand-link">
              <img src="/images/kkk.jpg" width="25" height="20" alt="Fluwent Logo">
              <span class="app-brand-text demo menu-text fw-bolder ms-2">Fluwentcash</span>
            </a>
            <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
              <i class="bx bx-chevron-left bx-sm align-middle"></i>
            </a>
          </div>
          <div class="menu-inner-shadow"></div>
          <ul class="menu-inner py-1">
            <!-- Dashboard -->
            <li class="menu-item">
              <a href="/admin/dashboard" class="menu-link">
                <i class="menu-icon tf-icons bx bx-home-circle"></i>
                <div>Dashboard</div>
              </a>
            </li>
            
            <!-- Manage Users -->
            <li class="menu-item">
              <a href="/all-users" class="menu-link">
                <i class="menu-icon tf-icons bx bx-user"></i>
                <div>Manage Users</div>
              </a>
            </li>

            <!-- ADD-OPTIONS Dropdown -->
            <li class="menu-item">
              <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-plus-circle"></i>
                <div>Add Options</div>
              </a>
              <ul class="menu-sub">
                <li class="menu-item">
                  <a href="/addlinks" class="menu-link">
                    <div>Add-Task</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/admin/banner-ads" class="menu-link">
                    <div>Banner-ADS</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/rewards" class="menu-link">
                    <div>Reward-controls</div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- CARD options Dropdown -->
            <li class="menu-item">
              <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon tf-icons bx bx-card"></i>
                <div>Card Options</div>
              </a>
              <ul class="menu-sub">
                <li class="menu-item">
                  <a href="/admin/cards" class="menu-link">
                    <div>Cards</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/admin/cards/create" class="menu-link">
                    <div>Create card</div>
                  </a>
                </li>
                <li class="menu-item">
                  <a href="/admin/card-stats" class="menu-link">
                    <div>Card-start</div>
                  </a>
                </li>
              </ul>
            </li>

            <!-- Link Task (Active) -->
            <li class="menu-item">
              <a href="/getlinks" class="menu-link">
                <i class="menu-icon tf-icons bx bx-link"></i>
                <div>Link-Task</div>
              </a>
            </li>

            <!-- IP Logs -->
            <li class="menu-item">
              <a href="/admin/ip-logs" class="menu-link">
                <i class="menu-icon tf-icons bx bx-shield-quarter"></i>
                <div>IP-logs</div>
              </a>
            </li>

            <!-- OOFD Submit -->
            <li class="menu-item">
              <a href="/submitted-data" class="menu-link">
                <i class="menu-icon tf-icons bx bx-file"></i>
                <div>OOFD-SUBMIT</div>
              </a>
            </li>

            <!-- Send Message -->
            <li class="menu-item">
              <a href="/sendmailusers" class="menu-link">
                <i class="menu-icon tf-icons bx bx-envelope"></i>
                <div>SendMessage</div>
              </a>
            </li>

            <!-- Recent Trx -->
            <li class="menu-item">
              <a href="/recent-transactions" class="menu-link">
                <i class="menu-icon tf-icons bx bx-transfer"></i>
                <div>RecentTrx</div>
              </a>
            </li>

            <!-- Logout -->
            <li class="menu-item">
              <a href="/logout" class="menu-link">
                <i class="menu-icon tf-icons bx bx-log-out"></i>
                <div>Logout</div>
              </a>
            </li>
          </ul>
        </aside>

        <div class="layout-page">
          <%- include('partials/othererror') %>
          <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme" id="layout-navbar">
            <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
              <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                <i class="bx bx-menu bx-sm"></i>
              </a>
            </div>
            <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
              <span class="fw-semibold text-muted d-none d-md-inline">CRASHCASH-Admin Dashboard</span>
              <ul class="navbar-nav flex-row align-items-center ms-auto">
                <li class="nav-item navbar-dropdown dropdown-user dropdown">
                  <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                    <div class="avatar avatar-online">
                      <img src="/images/sett.jpg" alt class="w-px-40 h-auto rounded-circle" />
                    </div>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <a class="dropdown-item" href="#">
                        <div class="d-flex">
                          <div class="flex-shrink-0 me-3">
                            <div class="avatar avatar-online">
                              <img src="/images/pro.jpg" alt class="w-px-40 h-auto rounded-circle" />
                            </div>
                          </div>
                          <div class="flex-grow-1">
                            <span class="fw-semibold d-block"><%= user.username %>!</span>
                            <small class="text-muted">Admin Account</small>
                          </div>
                        </div>
                      </a>
                    </li>
                    <li><div class="dropdown-divider"></div></li>
                    <li>
                      <a class="dropdown-item" href="/profile">
                        <i class="bx bx-user me-2"></i>
                        <span class="align-middle">My profile</span>
                      </a>
                    </li>
                    <li><div class="dropdown-divider"></div></li>
                    <li>
                      <a class="dropdown-item" href="/logout">
                        <i class="bx bx-power-off me-2"></i>
                        <span class="align-middle">Log Out</span>
                      </a>
                    </li>
                  </ul>
                </li>
              </ul>
            </div>
          </nav>

          <!-- Content wrapper -->
          <div class="content-wrapper">
            <!-- Content -->
            <div class="container-xxl flex-grow-1 container-p-y">
              <div class="row">
                <!-- Left Sidebar Cards (Stats) -->
                <div class="col-lg-4 col-md-5 col-12">
                  <!-- Stats Card -->
                  <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                      <h5 class="card-title m-0">User Statistics</h5>
                      <i class="bx bx-analyse text-muted"></i>
                    </div>
                    <div class="card-body">
                      <ul class="p-0 m-0">
                        <li class="d-flex mb-3 pb-1">
                          <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-primary"><i class="bx bx-group"></i></span>
                          </div>
                          <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                              <h6 class="mb-0">Total Users</h6>
                            </div>
                            <div class="user-progress d-flex align-items-center gap-1">
                              <span class="text-muted"><strong><%= totalUsers %></strong></span>
                            </div>
                          </div>
                        </li>
                        <li class="d-flex mb-3 pb-1">
                          <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-success"><i class="bx bx-user-check"></i></span>
                          </div>
                          <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                              <h6 class="mb-0">Active Users</h6>
                            </div>
                            <div class="user-progress d-flex align-items-center gap-1">
                              <span class="text-muted"><strong><%= activeUsers %></strong></span>
                            </div>
                          </div>
                        </li>
                        <li class="d-flex mb-1">
                          <div class="avatar flex-shrink-0 me-3">
                            <span class="avatar-initial rounded bg-label-danger"><i class="bx bx-user-x"></i></span>
                          </div>
                          <div class="d-flex w-100 flex-wrap align-items-center justify-content-between gap-2">
                            <div class="me-2">
                              <h6 class="mb-0">Banned Users</h6>
                            </div>
                            <div class="user-progress d-flex align-items-center gap-1">
                              <span class="text-muted"><strong><%= blockedUsers %></strong></span>
                            </div>
                          </div>
                        </li>
                      </ul>
                    </div>
                  </div>

                  <!-- Earnings Card -->
                  <div class="card mb-4">
                    <div class="card-header d-flex align-items-center justify-content-between">
                      <h5 class="card-title m-0">Total Earnings</h5>
                      <i class="bx bx-dollar text-muted"></i>
                    </div>
                    <div class="card-body">
                      <div class="d-flex align-items-center justify-content-between">
                        <span class="text-muted">Aggregated Volume</span>
                        <h4 class="text-success fw-bold mb-0">$<%= totalEarnings.toFixed(2) %></h4>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Right Table Side -->
                <div class="col-lg-8 col-md-7 col-12">
                  <div class="card mb-4">
                    <h5 class="card-header d-flex justify-content-between align-items-center">
                      <span>Recent Transactions</span>
                      <i class="bx bx-transfer text-muted"></i>
                    </h5>
                    <div class="card-body">
                      <div class="table-responsive text-nowrap">
                        <table class="table table-striped table-hover align-middle">
                          <thead>
                            <tr>
                              <th>Amount</th>
                              <th>Status</th>
                              <th>Type</th>
                              <th>Date</th>
                              <th>Transaction ID</th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody class="table-border-bottom-0">
                            <% if (transactions.length > 0) { %>
                              <% transactions.forEach(transaction => { %>
                                <tr>
                                  <td><span class="fw-semibold text-primary"><%= transaction.amount %></span></td>
                                  <td>
                                    <span class="badge bg-label-<%= transaction.status === 'Completed' ? 'success' : (transaction.status === 'Pending' ? 'warning' : 'danger') %>">
                                      <%= transaction.status %>
                                    </span>
                                  </td>
                                  <td><span class="badge bg-label-secondary"><%= transaction.type %></span></td>
                                  <td><%= new Date(transaction.createdAt).toLocaleDateString() %></td>
                                  <td><span class="text-muted text-xs"><%= transaction.userId %></span></td>
                                  <td>
                                    <form method="POST" action="/delete-transaction/<%= transaction._id %>?_method=POST" style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this transaction?');">
                                      <button type="submit" class="btn btn-xs btn-outline-danger">
                                        <i class="bx bx-trash me-1"></i>Delete
                                      </button>
                                    </form>
                                  </td>
                                </tr>
                              <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No recent withdrawals</td>
                              </tr>
                            <% } %>
                          </tbody>
                        </table>
                      </div>

                      <div class="text-center mt-4">
                        <a href="/recent-transactions" class="btn btn-outline-primary">
                          <i class="bx bx-right-arrow-alt me-1"></i>View More Transactions
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Balance Adjustment Form Card -->
              <div class="row">
                <div class="col-12">
                  <div class="card mb-4">
                    <h5 class="card-header d-flex align-items-center">
                      <i class="bx bx-wallet-alt me-2 text-primary"></i>Update User Balance
                    </h5>
                    <div class="card-body">
                      <form action="/update-balance" method="POST" class="row g-3">
                        <div class="col-md-6">
                          <label class="form-label" for="email">User Email</label>
                          <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                            <input type="email" id="email" name="email" class="form-control" placeholder="user@example.com" required />
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="balance">New Balance</label>
                          <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="bx bx-dollar"></i></span>
                            <input type="number" id="balance" name="balance" step="0.01" class="form-control" placeholder="0.00" required />
                          </div>
                        </div>
                        <div class="col-12 text-end">
                          <button type="submit" class="btn btn-primary">
                            <i class="bx bx-refresh me-1"></i>Update Balance
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </div>

            </div>
            <!-- / Content -->
            <div class="content-backdrop fade"></div>
          </div>
          <%- include('partials/footer') %>
        </div>
      </div>
      <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <!-- Core JS -->
    <script src="/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="/assets/vendor/libs/popper/popper.js"></script>
    <script src="/assets/vendor/js/bootstrap.js"></script>
    <script src="/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/assets/vendor/js/menu.js"></script>
    <!-- Vendors JS -->
    <script src="/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <!-- Main JS -->
    <script src="/assets/js/main.js"></script>
    <!-- Page JS -->
    <script src="/assets/js/dashboards-analytics.js"></script>
    <script async defer src="https://buttons.github.io/buttons.js"></script>
    
    <!-- INTEGRATED ADBLOCK ENGINE -->
    <script>
      function placeholderProbe() {
        return new Promise((resolve) => {
          const testElement = document.createElement('div');
          testElement.className = 'adsbygoogle adsbox pub_300x250 pub_300x250m pub_728x90 text-ad textAd';
          testElement.style.position = 'absolute';
          testElement.style.top = '-9999px';
          testElement.style.left = '-9999px';
          testElement.style.width = '1px';
          testElement.style.height = '1px';
          testElement.style.opacity = '0';
          testElement.style.pointerEvents = 'none';
          document.body.appendChild(testElement);
          const rect = testElement.getBoundingClientRect();
          const style = window.getComputedStyle(testElement);
          const blocked =
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            rect.width === 0 ||
            rect.height === 0;
          testElement.remove();
          resolve(blocked);
        });
      }
      function networkProbe() {
        return new Promise((resolve) => {
          const script = document.createElement('script');
          const cleanup = () => {
            if (script.parentNode) {
              script.parentNode.removeChild(script);
            }
          };
          const timer = window.setTimeout(() => {
            cleanup();
            resolve(false);
          }, 600);
          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
          script.onload = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(false);
          };
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(true);
          };
          document.head.appendChild(script);
        });
      }
      function handleAdBlocker() {
        document.getElementById("adblock-overlay").style.display = "block";
        const dashboardContent = document.getElementById("layout-wrapper");
        if (dashboardContent) {
          dashboardContent.style.display = "none";
        }
      }
      window.addEventListener('DOMContentLoaded', async function() {
        const placeholderBlocked = await placeholderProbe();
        const adRequestBlocked = await networkProbe();
        
        if (placeholderBlocked || adRequestBlocked) {
          handleAdBlocker();
        }
      });
    </script>
  </body>
</html>


