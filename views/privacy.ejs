    <!-- INTEGRATED ADBLOCK ENGINE -->
    <script>
      function placeholderProbe() {
        return new Promise((resolve) => {
          const testElement = document.createElement('div');
          testElement.className = 'adsbygoogle adsbox pub_300x250 pub_300x250m pub_728x90 text-ad textAd';
          testElement.style.position = 'absolute';
          testElement.style.top = '-9999px';
          testElement.style.left = '-9999px';
          testElement.style.width = '1px';
          testElement.style.height = '1px';
          testElement.style.opacity = '0';
          testElement.style.pointerEvents = 'none';
          document.body.appendChild(testElement);
          
          const rect = testElement.getBoundingClientRect();
          const style = window.getComputedStyle(testElement);
          
          // FIXED: Added missing '||' logical operators
          const blocked =
            style.display === 'none' ||
            style.visibility === 'hidden' ||
            rect.width === 0 ||
            rect.height === 0;

          testElement.remove();
          resolve(blocked);
        });
      }

      function networkProbe() {
        return new Promise((resolve) => {
          const script = document.createElement('script');
          const cleanup = () => {
            if (script.parentNode) {
              script.parentNode.removeChild(script);
            }
          };

          const timer = window.setTimeout(() => {
            cleanup();
            resolve(false);
          }, 600);

          script.async = true;
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?cb=' + Date.now();
          script.onload = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(false);
          };
          script.onerror = () => {
            window.clearTimeout(timer);
            cleanup();
            resolve(true);
          };

          document.head.appendChild(script);
        });
      }

      function handleAdBlocker() {
        document.getElementById("adblock-overlay").style.display = "block";
        const dashboardContent = document.getElementById("verify-card");
        if (dashboardContent) {
          dashboardContent.style.display = "none";
        }
      }

      window.addEventListener('DOMContentLoaded', async function() {
        const placeholderBlocked = await placeholderProbe();
        const adRequestBlocked = await networkProbe();
        
        // FIXED: Added missing '||' logical operator
        if (placeholderBlocked || adRequestBlocked) {
          handleAdBlocker();
        }
      });
    </script>
