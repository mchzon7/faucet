<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 font-sans text-slate-900">
  <%- include('partials/header') %>

  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <% if (featuredPost) { %>
      <section class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <!-- /blog/<%= featuredPost.slug %> -->
        <a href="#" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <img src="<%= featuredPost.coverImage %>" alt="<%= featuredPost.title %>" class="h-72 w-full object-cover sm:h-96">
          <div class="p-6">
            <span class="rounded-full bg-[#595cd9]/15 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-[#595cd9]"><%= featuredPost.category %></span>
            <h1 class="mt-4 text-3xl font-extrabold leading-tight text-brand-ink group-hover:text-[#595cd9] sm:text-4xl"><%= featuredPost.title %></h1>
            <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600"><%= featuredPost.excerpt %></p>
            <div class="mt-5 flex flex-wrap gap-4 text-sm font-semibold text-slate-500">
              <span><%= featuredPost.readTime %> min read</span>
              <span><%= new Date(featuredPost.publishedAt || featuredPost.createdAt).toLocaleDateString('en', { dateStyle: 'medium' }) %></span>
            </div>
          </div>
        </a>

        <aside class="space-y-5">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <h2 class="text-lg font-extrabold text-slate-950">Categories</h2>
            <div class="mt-4 space-y-3">
              <% categories.forEach((category) => { %>
                <div class="flex items-center justify-between text-sm">
                  <span class="font-bold text-slate-700"><%= category._id %></span>
                  <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-bold text-slate-500"><%= category.count %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <h2 class="text-lg font-extrabold text-slate-950">Trending Posts</h2>
            <div class="mt-4 space-y-4">
              <% trendingPosts.forEach((post) => { %>
                <!-- /blog/<%= post.slug %> -->
                <a href="#" class="block border-b border-slate-100 pb-4 last:border-0 last:pb-0">
                  <span class="text-sm font-extrabold text-slate-900 hover:text-[#595cd9]"><%= post.title %></span>
                  <span class="mt-1 block text-xs font-semibold text-slate-500"><%= post.readTime %> min read</span>
                </a>
              <% }) %>
            </div>
          </div>

          <div class="rounded-xl bg-brand-ink p-6 text-white">
            <p class="text-sm font-bold text-[#595cd9]">Earn while you learn</p>
            <h2 class="mt-2 text-2xl font-extrabold">Claim your first faucet reward today.</h2>
            <a href="/register" class="mt-5 inline-flex rounded-lg bg-[#595cd9]/75 px-5 py-3 text-sm font-extrabold text-slate-950 hover:bg-[#595cd9]">Create free account</a>
          </div>
        </aside>
      </section>
    <% } else { %>
      <section class="rounded-xl border border-slate-200 bg-white p-8 text-center">
        <h1 class="text-3xl font-extrabold text-brand-ink">No published articles yet</h1>
        <p class="mt-3 text-slate-600">Seed the database or publish a post to populate the blog.</p>
      </section>
    <% } %>

    <section class="mt-12">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="text-sm font-extrabold uppercase tracking-wider text-[#595cd9]">Latest guides</p>
          <h2 class="mt-2 text-3xl font-extrabold text-brand-ink">Faucet strategy articles</h2>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% posts.forEach((post) => { %>
          <article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href="/blog/<%= post.slug %>">
              <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="h-48 w-full object-cover">
            </a>
            <div class="p-5">
              <span class="rounded-full bg-[#595cd9]/15 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-[#595cd9]"><%= post.category %></span>
              <!-- /blog/<%= post.slug %> -->
              <a href="#">
                <h3 class="mt-4 text-xl font-extrabold leading-snug text-slate-950 hover:text-[#595cd9]"><%= post.title %></h3>
              </a>
              <p class="mt-3 text-sm leading-6 text-slate-600"><%= post.excerpt %></p>
              <div class="mt-5 flex flex-wrap gap-3 text-xs font-bold text-slate-500">
                <span><%= post.readTime %> min read</span>
                <span><%= new Date(post.publishedAt || post.createdAt).toLocaleDateString('en', { dateStyle: 'medium' }) %></span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <nav class="mt-10 flex items-center justify-center gap-3" aria-label="Blog pagination">
          <% if (pagination.hasPrev) { %>
            <a href="/blog?page=<%= pagination.prevPage %>" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100">Previous</a>
          <% } %>
          <span class="text-sm font-bold text-slate-500">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
          <% if (pagination.hasNext) { %>
            <a href="/blog?page=<%= pagination.nextPage %>" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-100">Next</a>
          <% } %>
        </nav>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
